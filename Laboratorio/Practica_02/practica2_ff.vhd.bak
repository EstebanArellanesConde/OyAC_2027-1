library IEEE;

use IEEE.STD_LOGIC_1164.ALL;

entity practica2_vhdl is

    Port (
        CLK   : in  STD_LOGIC;
        RESET : in  STD_LOGIC;

        E1    : in  STD_LOGIC;
        E2    : in  STD_LOGIC;

        S     : out STD_LOGIC_VECTOR(1 downto 0)
    );

end practica2_vhdl;


architecture Behavioral of practica2_vhdl is

    -- Estados:
    -- A = 00
    -- B = 01
    -- C = 10
    -- D = 11

    signal EDO_PRES : STD_LOGIC_VECTOR(1 downto 0) := "00";
    signal EDO_SIG  : STD_LOGIC_VECTOR(1 downto 0);

begin

    ------------------------------------------------------------
    -- REGISTRO DE ESTADO
    ------------------------------------------------------------

    process(CLK, RESET)
    begin

        if RESET = '0' then

            EDO_PRES <= "00";

        elsif rising_edge(CLK) then

            EDO_PRES <= EDO_SIG;

        end if;

    end process;


    ------------------------------------------------------------
    -- LOGICA DE SIGUIENTE ESTADO
    ------------------------------------------------------------

    process(EDO_PRES, E1, E2)
    begin

        case EDO_PRES is

            ----------------------------------------------------
            -- A = 00
            ----------------------------------------------------
            when "00" =>

                -- A -> B
                EDO_SIG <= "01";


            ----------------------------------------------------
            -- B = 01
            ----------------------------------------------------
            when "01" =>

                if E1 = '1' then

                    -- B -> B
                    EDO_SIG <= "01";

                elsif E2 = '1' then

                    -- B -> A
                    EDO_SIG <= "00";

                else

                    -- B -> C
                    EDO_SIG <= "10";

                end if;


            ----------------------------------------------------
            -- C = 10
            ----------------------------------------------------
            when "10" =>

                -- C -> D
                EDO_SIG <= "11";


            ----------------------------------------------------
            -- D = 11
            ----------------------------------------------------
            when "11" =>

                if E2 = '0' then

                    -- D -> D
                    EDO_SIG <= "11";

                else

                    -- D -> A
                    EDO_SIG <= "00";

                end if;


            ----------------------------------------------------
            -- ESTADO NO VALIDO
            ----------------------------------------------------
            when others =>

                EDO_SIG <= "00";

        end case;

    end process;


    ------------------------------------------------------------
    -- LOGICA DE SALIDA
    --
    -- S(1) = S1
    -- S(0) = S0
    ------------------------------------------------------------

    process(EDO_PRES)
    begin

        case EDO_PRES is

            -- A
            -- S1 = 1
            -- S0 = 1
            when "00" =>
                S <= "11";


            -- B
            -- S1 = 1
            -- S0 = 0
            when "01" =>
                S <= "10";


            -- C
            -- S1 = 0
            -- S0 = 1
            when "10" =>
                S <= "01";


            -- D
            -- S1 = 0
            -- S0 = 0
            when "11" =>
                S <= "00";


            when others =>
                S <= "00";

        end case;

    end process;

end Behavioral;