set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name TOP_LEVEL_ENTITY practica4
set_global_assignment -name VHDL_FILE practica4.vhd
set_global_assignment -name VHDL_FILE tb_practica4.vhd
set_global_assignment -name SDC_FILE Practica4.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name LAST_QUARTUS_VERSION "20.1.0 Lite Edition"
set_global_assignment -name DEVICE EP4CE6E22C8
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_location_assignment PIN_23 -to clk
set_location_assignment PIN_25 -to reset
set_location_assignment PIN_88 -to W
set_location_assignment PIN_89 -to X
set_location_assignment PIN_90 -to Y
set_location_assignment PIN_91 -to Z
set_location_assignment PIN_85 -to estado[2]
set_location_assignment PIN_86 -to estado[1]
set_location_assignment PIN_87 -to estado[0]
set_location_assignment PIN_84 -to prueba
set_location_assignment PIN_126 -to salidas[5]
set_location_assignment PIN_132 -to salidas[4]
set_location_assignment PIN_129 -to salidas[3]
set_location_assignment PIN_125 -to salidas[2]
set_location_assignment PIN_121 -to salidas[1]
set_location_assignment PIN_128 -to salidas[0]
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top